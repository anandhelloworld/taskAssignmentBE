# Copy to .env and fill in. Never commit the real .env.

# Port the API listens on
PORT=5000

# MongoDB connection string (MongoDB Atlas or local), including the database name
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/task-management?retryWrites=true&w=majority

# Long random string used to sign JWTs
JWT_SECRET=change_this_to_a_long_random_string

# Token lifetime (e.g. 1d, 12h)
JWT_EXPIRES_IN=1d

# Allowed frontend origin for CORS + Socket.IO (no trailing slash).
# If unset, the server falls back to "*" — always set this in production.
CLIENT_ORIGIN=http://localhost:4200
